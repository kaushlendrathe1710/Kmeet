# PodcastMeet Environment Configuration

# Session Secret
# A secure random string used to sign session cookies
# REQUIRED: Generate a secure random string for production
# Example: openssl rand -base64 32
SESSION_SECRET=your-secret-key-here

# Server Configuration
# PORT is automatically set by Replit, do not modify
# PORT=5000

# Node Environment
# Automatically set to 'development' by npm run dev
# NODE_ENV=development
