# PodcastMeet Environment Variables

# Session Secret (Required)
# Used for securing session data
# Generate a random string for production
SESSION_SECRET=your-secret-key-here

# Server Configuration
PORT=5000
NODE_ENV=development

# WebSocket Configuration
# The WebSocket server runs on the same port as the HTTP server
# No additional configuration needed

# Database Configuration
# Currently using in-memory storage
# No database configuration needed for development
# For production, you would configure PostgreSQL here:
# DATABASE_URL=postgresql://user:password@host:port/database

# STUN/TURN Server Configuration (Optional)
# Default: Uses Google's public STUN servers
# Add your own TURN servers for better connectivity:
# TURN_SERVER_URL=turn:your-turn-server.com:3478
# TURN_USERNAME=your-username
# TURN_CREDENTIAL=your-password

# Frontend Configuration
# These are automatically available in Vite with VITE_ prefix
# VITE_WS_URL=ws://localhost:5000 (auto-configured in development)
